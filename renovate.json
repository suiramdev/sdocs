{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Paris",
  "schedule": ["before 6am"],
  "automergeSchedule": ["before 6am"],
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Automerge patch/minor npm/bun dependency updates (repo has no CI, so tests are not awaited)",
      "matchManagers": ["npm", "bun"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "ignoreTests": true
    },
    {
      "description": "Automerge patch/minor oven/bun base image and packageManager updates",
      "matchPackageNames": ["oven/bun", "bun"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "ignoreTests": true
    },
    {
      "description": "Never automerge major updates",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Meilisearch needs a snapshot + --upgrade-db / dumpless upgrade: always manual review",
      "matchPackageNames": ["getmeili/meilisearch"],
      "automerge": false,
      "labels": ["manual-upgrade"]
    }
  ]
}
